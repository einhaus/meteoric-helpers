{
    "name": "@einhaus/meteoric-helpers",
    "version": "1.0.174",
    "files": [
        "dist",
        "docs/database-mcp.md",
        "README.md"
    ],
    "exports": {
        "./mcp/database": {
            "types": "./dist/mcp/database.d.ts",
            "import": "./dist/mcp/database.js"
        },
        ".": {
            "import": "./dist/index.js",
            "require": "./dist/index.cjs",
            "types": "./dist/index.d.ts"
        },
        "./dbHelpers/mysql": {
            "import": "./dist/dbHelpers/mysql.js",
            "require": "./dist/dbHelpers/mysql.cjs",
            "types": "./dist/dbHelpers/mysql.d.ts"
        },
        "./dist/dbHelpers/mysql": {
            "import": "./dist/dbHelpers/mysql.js",
            "require": "./dist/dbHelpers/mysql.cjs",
            "types": "./dist/dbHelpers/mysql.d.ts"
        },
        "./dbHelpers/postgres": {
            "import": "./dist/dbHelpers/postgres.js",
            "require": "./dist/dbHelpers/postgres.cjs",
            "types": "./dist/dbHelpers/postgres.d.ts"
        },
        "./node": {
            "import": "./dist/node.js",
            "require": "./dist/node.cjs",
            "types": "./dist/node.d.ts"
        },
        "./node.js": {
            "import": "./dist/node.js",
            "require": "./dist/node.cjs",
            "types": "./dist/node.d.ts"
        },
        "./*": {
            "import": "./dist/*.js",
            "require": "./dist/*.cjs",
            "types": "./dist/*.d.ts"
        }
    },
    "browser": "./dist/index.js",
    "main": "./dist/index.js",
    "types": "dist/index.d.ts",
    "author": "Meteoric, LLC",
    "license": "MIT",
    "description": "A collection of helper functions used in Meteoric LLC projects.",
    "type": "module",
    "packageManager": "bun@1.4.4",
    "engines": {
        "bun": ">=1.4.4"
    },
    "scripts": {
        "clean": "rm -rf ./dist",
        "build": "bun run clean && tsc -v && bun -v && bun './utilities/buildBarrelFile.ts' && tsc -p .",
        "test": "vitest run --dir ./test",
        "build:barrel": "bun './utilities/buildBarrelFile.ts'",
        "watch:barrel": "bun './utilities/watchBarrelFile.ts'",
        "watch": "bun run clean && bun run build:barrel && tsc -p . && concurrently \"tsc -p . --watch --preserveWatchOutput\" \"bun run watch:barrel -- --no-initial\"",
        "type-check": "bun check",
        "lint": "oxlint --disable-nested-config --deny-warnings --report-unused-disable-directives-severity=error .",
        "lint:all": "bun run lint",
        "lint:fix": "oxlint --disable-nested-config --fix --deny-warnings --report-unused-disable-directives-severity=error .",
        "format": "bun fmt .",
        "format:check": "bun fmt --check .",
        "prepublishOnly": "bun run build && node utilities/assertCleanPublish.mjs"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/einhaus/meteoric-helpers.git"
    },
    "devDependencies": {
        "@types/bcrypt": "^6.0.0",
        "@types/mime-types": "^3.0.1",
        "@types/node": "^26.6.5",
        "@types/pg": "^8.23.1",
        "concurrently": "^10.0.6",
        "oxlint": "^1.89.0",
        "oxlint-tsgolint": "^7.0.2005",
        "typescript": "^7.0.2",
        "vitest": "^5.0.5",
        "zod": "^4.6.7"
    },
    "publishConfig": {
        "registry": "https://npm.pkg.github.com/",
        "access": "restricted"
    },
    "private": false,
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1156.0",
        "@aws-sdk/client-ses": "^3.1156.0",
        "@aws-sdk/s3-request-presigner": "^3.1156.0",
        "@clickhouse/client": "^1.24.1",
        "@modelcontextprotocol/sdk": "1.32.2",
        "@redis/client": "^6.3.0",
        "bcrypt": "^6.0.0",
        "dayjs": "^1.11.23",
        "jose": "6.2.13",
        "mime-types": "^3.0.2",
        "mysql2": "^3.24.6",
        "nanoid": "^6.0.2",
        "node-cache": "^5.1.2",
        "node-sql-parser": "5.4.0",
        "pg": "^8.23.1"
    },
    "overrides": {
        "fast-xml-parser": "5.3.6",
        "rollup": "4.59.0",
        "minimatch@3": "3.1.5",
        "minimatch@9": "9.0.9",
        "minimatch@10": "10.2.4",
        "typescript": "^7.0.2",
        "oxlint-tsgolint": "^7.0.2001"
    },
    "peerDependencies": {
        "zod": "^4.6.5"
    }
}
