{
  "name": "@einhaus/meteoric-helpers",
  "version": "1.0.93",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dist/dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dbHelpers/postgres": {
      "import": "./dist/dbHelpers/postgres.js",
      "require": "./dist/dbHelpers/postgres.cjs",
      "types": "./dist/dbHelpers/postgres.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./node.js": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "types": "./dist/*.d.ts"
    }
  },
  "browser": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Meteoric, LLC",
  "license": "MIT",
  "description": "A collection of helper functions used in Meteoric LLC projects.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc -v && node -v && tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts' && tsc -p .",
    "test": "vitest --dir ./test",
    "build:barrel": "tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts'",
    "watch": "npm run clean && npm run build:barrel && tsc -p . && concurrently \"tsc -p . --watch --preserveWatchOutput\" \"nodemon\"",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhaus/meteoric-helpers.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": ">=25.2.3",
    "@types/pg": "^8.16.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-sonarjs": "^4.0.0",
    "prettier": "3.8.1",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^4.0.18"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "private": false,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.992.0",
    "@aws-sdk/client-ses": "^3.992.0",
    "@aws-sdk/s3-request-presigner": "^3.992.0",
    "@clickhouse/client": "^1.17.0",
    "@eslint/eslintrc": "^3.3.3",
    "@redis/client": "^5.11.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.19",
    "mime-types": "^3.0.2",
    "mysql2": "^3.17.2",
    "nanoid": "^5.1.6",
    "node-cache": "^5.1.2",
    "pg": "^8.18.0",
    "tsx": "^4.21.0",
    "typedi": "^0.10.0"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6"
  }
}