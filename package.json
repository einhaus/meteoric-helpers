{
  "name": "@einhaus/meteoric-helpers",
  "version": "1.0.66",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dist/dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dbHelpers/postgres": {
      "import": "./dist/dbHelpers/postgres.js",
      "require": "./dist/dbHelpers/postgres.cjs",
      "types": "./dist/dbHelpers/postgres.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./node.js": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "types": "./dist/*.d.ts"
    }
  },
  "browser": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Meteoric, LLC",
  "license": "MIT",
  "description": "A collection of helper functions used in Meteoric LLC projects.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc -v && node -v && tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts' && tsc -p .",
    "test": "vitest --dir ./test",
    "build:barrel": "tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts'",
    "watch": "npm run clean && npm run build:barrel && tsc -p . && concurrently \"tsc -p . --watch --preserveWatchOutput\" \"nodemon\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhaus/meteoric-helpers.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.27.0",
    "@types/bcrypt": "^5.0.2",
    "@types/mime-types": "^2.1.4",
    "@types/node": ">=22.15.21",
    "@types/pg": "^8.15.2",
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.27.0",
    "eslint-config-prettier": ">=10.1.5",
    "eslint-plugin-prettier": ">=5.4.0",
    "eslint-plugin-sonarjs": "^3.0.2",
    "prettier": "3.5.3",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.32.1",
    "vitest": "^3.1.4"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "private": false,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.817.0",
    "@aws-sdk/client-ses": "^3.817.0",
    "@clickhouse/client": "^1.11.1",
    "@eslint/eslintrc": "^3.3.1",
    "@redis/client": "^5.1.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.13",
    "mime-types": "^3.0.1",
    "mysql2": "^3.14.1",
    "nanoid": "^5.1.5",
    "node-cache": "^5.1.2",
    "pg": "^8.16.0",
    "tsx": "^4.19.4",
    "typedi": "^0.10.0"
  }
}