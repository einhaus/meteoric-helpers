{
  "name": "@einhaus/meteoric-helpers",
  "version": "1.0.34",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Meteoric, LLC",
  "license": "MIT",
  "description": "A collection of helper functions used in Meteoric LLC projects.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "npm run clean && tsc -v && node -v && tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts' && tsc -p .",
    "test": "vitest --dir ./test",
    "build:barrel": "tsx -r tsconfig-paths/register './utilities/buildBarrelFile.ts'",
    "watch": "npm run clean && npm run build:barrel && tsc -p . && concurrently \"tsc -p . --watch --preserveWatchOutput\" \"nodemon\""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhaus/meteoric-helpers.git"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": ">=22.13.10",
    "@typescript-eslint/eslint-plugin": "^8.26.1",
    "@typescript-eslint/parser": "^8.26.1",
    "concurrently": "^9.1.2",
    "eslint": "^9.22.0",
    "eslint-config-prettier": ">=10.1.1",
    "eslint-plugin-prettier": ">=5.2.3",
    "eslint-plugin-sonarjs": "^3.0.2",
    "prettier": "3.5.3",
    "tsc-alias": "^1.8.11",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "private": false,
  "dependencies": {
    "@aws-sdk/client-ses": "^3.758.0",
    "@eslint/eslintrc": "^3.3.0",
    "dayjs": "^1.11.13",
    "mime-types": "^2.1.35",
    "typedi": "^0.10.0"
  }
}
