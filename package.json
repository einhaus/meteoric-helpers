{
  "name": "@einhaus/meteoric-helpers",
  "version": "1.0.133",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dist/dbHelpers/mysql": {
      "import": "./dist/dbHelpers/mysql.js",
      "require": "./dist/dbHelpers/mysql.cjs",
      "types": "./dist/dbHelpers/mysql.d.ts"
    },
    "./dbHelpers/postgres": {
      "import": "./dist/dbHelpers/postgres.js",
      "require": "./dist/dbHelpers/postgres.cjs",
      "types": "./dist/dbHelpers/postgres.d.ts"
    },
    "./node": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./node.js": {
      "import": "./dist/node.js",
      "require": "./dist/node.cjs",
      "types": "./dist/node.d.ts"
    },
    "./*": {
      "import": "./dist/*.js",
      "require": "./dist/*.cjs",
      "types": "./dist/*.d.ts"
    }
  },
  "browser": "./dist/index.js",
  "main": "./dist/index.js",
  "types": "dist/index.d.ts",
  "author": "Meteoric, LLC",
  "license": "MIT",
  "description": "A collection of helper functions used in Meteoric LLC projects.",
  "type": "module",
  "scripts": {
    "clean": "rm -rf ./dist",
    "build": "bun run clean && tsc -v && bun -v && bun './utilities/buildBarrelFile.ts' && tsc -p .",
    "test": "vitest --dir ./test",
    "build:barrel": "bun './utilities/buildBarrelFile.ts'",
    "watch:barrel": "bun './utilities/watchBarrelFile.ts'",
    "watch": "bun run clean && bun run build:barrel && tsc -p . && concurrently \"tsc -p . --watch --preserveWatchOutput\" \"bun run watch:barrel -- --no-initial\"",
    "type-check": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/einhaus/meteoric-helpers.git"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "@typescript-eslint/eslint-plugin": "^8.63.0",
    "@typescript-eslint/parser": "^8.63.0",
    "concurrently": "^10.0.3",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-sonarjs": "^4.1.0",
    "prettier": "3.9.5",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.63.0",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/",
    "access": "restricted"
  },
  "private": false,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1084.0",
    "@aws-sdk/client-ses": "^3.1084.0",
    "@aws-sdk/s3-request-presigner": "^3.1084.0",
    "@clickhouse/client": "^1.23.1",
    "@eslint/eslintrc": "^3.3.5",
    "@redis/client": "^6.1.0",
    "bcrypt": "^6.0.0",
    "dayjs": "^1.11.21",
    "mime-types": "^3.0.2",
    "mysql2": "^3.22.6",
    "nanoid": "^5.1.16",
    "node-cache": "^5.1.2",
    "pg": "^8.22.0"
  },
  "overrides": {
    "fast-xml-parser": "5.3.6",
    "rollup": "4.59.0",
    "minimatch@3": "3.1.5",
    "minimatch@9": "9.0.9",
    "minimatch@10": "10.2.4"
  }
}
